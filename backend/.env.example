# Copy to backend/.env and fill in real values. NEVER commit .env.
# The backend refuses to start without SECRET_KEY (see create_app in app.py).

# Required: long random string used to sign JWTs. Generate one with e.g.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: defaults to sqlite:///finance.db
# SQLALCHEMY_DATABASE_URI=sqlite:///finance.db
